# Normalize line endings: store LF in the repository, check out native on each OS.
# This eliminates CRLF/LF churn and the doubled-CR artifacts on Windows checkouts, so diffs and the
# pre-registration freeze hash are byte-stable across platforms.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders for the determinism-critical sources).
*.py     text eol=lf
*.pyi    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.sh     text eol=lf
*.bib    text eol=lf
*.tex    text eol=lf
*.cff    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
Makefile text eol=lf

# Binary artifacts — never normalized, never diffed as text.
*.parquet binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.pkl     binary
*.npy     binary
*.npz     binary
*.ico     binary

# Linguist / language stats: keep the repository classified as a research codebase.
*.ipynb       linguist-documentation
